# Fiscal Astra local development configuration.
# Copy this file to .env; never commit the copied file.

ASTRA_APP_NAME=Fiscal Astra
ASTRA_ENVIRONMENT=development
ASTRA_DEBUG=false
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8000
ASTRA_LOG_LEVEL=INFO
ASTRA_DATABASE_URL=postgresql+psycopg://astra:change-me@127.0.0.1:5432/fiscal_astra
ASTRA_ARTIFACT_ROOT=artifacts
ASTRA_LLM_PROVIDER=mock
ASTRA_LLM_BASE_URL=
ASTRA_LLM_MODEL=