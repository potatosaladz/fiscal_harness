# Fiscal Astra local development configuration.
# Copy this file to .env; never commit the copied file.

ASTRA_APP_NAME=Fiscal Astra
ASTRA_ENVIRONMENT=development
ASTRA_DEBUG=false
ASTRA_HOST=127.0.0.1
ASTRA_PORT=8000
ASTRA_LOG_LEVEL=INFO
ASTRA_DATABASE_URL=postgresql+psycopg://astra:change-me@127.0.0.1:5432/fiscal_astra
ASTRA_BROKER_URL=redis://127.0.0.1:6379/0
ASTRA_SIMULATION_QUEUE_NAME=simulations
ASTRA_ORCHESTRATOR_QUEUE_NAME=orchestrator
ASTRA_SIMULATION_MAX_ATTEMPTS=3
ASTRA_SIMULATION_RETRY_MIN_BACKOFF_MS=1000
ASTRA_SIMULATION_RETRY_MAX_BACKOFF_MS=30000
ASTRA_ARTIFACT_ROOT=artifacts
ASTRA_DATA_ROOT=data
# Comma-separated hostnames accepted by remote data retrieval, for example:
# ASTRA_RETRIEVAL_URL_ALLOWLIST=api.example.gov,statistics.example.gov
ASTRA_RETRIEVAL_URL_ALLOWLIST=[]
ASTRA_RETRIEVAL_REQUEST_TIMEOUT_SECONDS=15
ASTRA_LLM_PROVIDER=mock
ASTRA_LLM_BASE_URL=
ASTRA_LLM_MODEL=